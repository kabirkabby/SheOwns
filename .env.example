# ==============================================================================
# SHEOWNS ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. RESEND EMAIL SERVICE (https://resend.com - Free 3,000 emails/mo)
# Create a free account at Resend.com and paste your API key here:
RESEND_API_KEY=

# The email address where your sales advisors / team should receive new leads:
NOTIFICATION_EMAIL=info@sheowns.com

# Verified sender email address:
RESEND_FROM_EMAIL=SheOwns Leads <leads@leads.sheownsdubai.com>

# 2. GOOGLE SHEETS / AIRTABLE / MAKE.COM WEBHOOK (OPTIONAL)
# If you want every lead automatically inserted as a row in Google Sheets:
# Paste your Google Apps Script Webhook URL or SheetDB / Make / Zapier webhook URL here:
GOOGLE_SHEETS_WEBHOOK_URL=
